# Copy to .env and fill in. Never commit .env.

# Retell API key. Use the key with the webhook badge, so the same key verifies webhooks.
RETELL_API_KEY=

# Public https URL of the backend, for example your ngrok URL. No trailing slash.
BACKEND_URL=

# Model for the live Retell agent. Retell bills it from your Retell credit.
AGENT_MODEL=gemini-3.6-flash

# Optional. Pin a voice instead of using the first Indian female voice found.
RETELL_VOICE_ID=

# Optional. E.164 number of the human collections desk. Leave empty to disable live transfer.
HUMAN_DESK_NUMBER=

# Test lab models, through any OpenAI-compatible API. Default: Groq free tier (no card).
# Get a key at console.groq.com/keys.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=

# The live agent runs AGENT_MODEL on Retell. Groq does not serve that model, so the lab
# runs an open model instead, and the 10 Retell test cases cover the exact model.
LAB_AGENT_MODEL=qwen/qwen3.8-27b
LAB_AGENT_TEMPERATURE=0.3
SIM_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=openai/gpt-oss-120b

# Free-tier limits per model. Check console.groq.com/settings/limits and copy your numbers.
# Groq's free tier allows 8,000 tokens a minute per model, and one agent turn uses 3,000 to 5,000,
# so the agent is held to about 2 requests a minute.
AGENT_RPM=2
SIM_RPM=6
JUDGE_RPM=3
AGENT_TPD=200000
SIM_TPD=200000
JUDGE_TPD=200000

# Simulated user model for the Retell test cases (must be a model Retell offers).
RETELL_SIM_MODEL=gemini-3.5-flash-lite
